APP_NAME="Search Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8089

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=search-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

JWT_ISSUER=http://auth-app
JWT_AUDIENCE=ecommerce
JWT_JWKS_URL=http://auth-nginx/.well-known/jwks.json
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CATALOG_URL=http://catalog-nginx/api

ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_INDEX=products
ELASTICSEARCH_TIMEOUT=2
ELASTICSEARCH_CONNECT_TIMEOUT=1
SEARCH_CACHE_TTL=120

KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=search-service-catalog-group
KAFKA_TOPIC_CATALOG_EVENTS=catalog.events
KAFKA_DLQ_CATALOG_EVENTS=catalog.events.dlq.search-service
KAFKA_TOPIC_SEARCH_EVENTS=search.events
KAFKA_FAILED_MESSAGE_RETRIES=5
KAFKA_FAILED_MESSAGE_BACKOFF_MS=2000

ANALYTICS_RABBITMQ_URL=amqp://guest:guest@analytics-rabbitmq:5672/
ANALYTICS_RABBITMQ_EXCHANGE=analytics.events

FORWARD_HTTP_PORT=8089
FORWARD_HTTPS_PORT=8446
FORWARD_REDIS_PORT=6383
FORWARD_ELASTICSEARCH_PORT=9200
