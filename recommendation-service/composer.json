{
    "name": "ecommerce/recommendation-service",
    "description": "AI-рекомендации и консультационный чат магазина.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "~8.5.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "ext-rdkafka": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "ecommerce/platform-kit": "^1.0",
        "firebase/php-jwt": "^7.2",
        "pgvector/pgvector": "^0.2.2",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "ufo-tech/kafka-messenger": "^1.0",
        "zircote/swagger-php": "^6.18"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.9",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/maker-bundle": "^1.68"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../packages/platform-kit",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "platform-check": "php-only",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "lint": "php-cs-fixer check --show-progress=none",
        "lint:fix": "php-cs-fixer fix",
        "analyse": [
            "@php bin/console cache:warmup --env=dev --quiet @no_additional_args",
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "analyse:baseline": [
            "@php bin/console cache:warmup --env=dev --quiet @no_additional_args",
            "phpstan analyse --memory-limit=1G --generate-baseline --allow-empty-baseline"
        ],
        "refactor": [
            "@php bin/console cache:warmup --env=dev --quiet @no_additional_args",
            "rector process --dry-run --no-progress-bar"
        ],
        "refactor:fix": [
            "@php bin/console cache:warmup --env=dev --quiet @no_additional_args",
            "rector process --no-progress-bar"
        ],
        "test": "@php vendor/bin/phpunit",
        "check": [
            "@lint",
            "@refactor",
            "@analyse",
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config --parse-tags",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
