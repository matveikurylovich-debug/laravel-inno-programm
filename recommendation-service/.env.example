APP_ENV=dev
APP_SECRET=change_me_recommendation_secret

DATABASE_URL=postgresql://app_user:secret@recommendation-pgvector:5432/recommendation_db?serverVersion=16&charset=utf8

KAFKA_BROKERS=kafka:9092
KAFKA_CATALOG_TOPIC=catalog.events
KAFKA_CONSUMER_GROUP=recommendation-indexer-group
KAFKA_DSN=kafka://${KAFKA_BROKERS}/${KAFKA_CATALOG_TOPIC}?group.id=${KAFKA_CONSUMER_GROUP}

GEMINI_API_KEY=placeholder
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
SIMILARITY_THRESHOLD=0.68

JWT_PUBLIC_KEY_PATH=%kernel.project_dir%/config/jwt/public.pem
