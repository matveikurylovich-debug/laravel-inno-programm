APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

DATABASE_URL="postgresql://app_user:@recommendation-pgvector:5432/recommendation_db?serverVersion=16&charset=utf8"

KAFKA_BROKERS=kafka:9092
KAFKA_CATALOG_TOPIC=catalog.events
KAFKA_CONSUMER_GROUP=recommendation-indexer-group
KAFKA_DSN=kafka://${KAFKA_BROKERS}/${KAFKA_CATALOG_TOPIC}?group.id=${KAFKA_CONSUMER_GROUP}

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TEXT_MODEL=gemini-3.5-flash
SIMILARITY_THRESHOLD=0.57
CONVERSATION_TTL_MINUTES=30

JWT_JWKS_URL=http://auth-nginx/api/v1/internal/jwks
JWT_JWKS_PATH=
JWT_ISSUER=http://auth-app
JWT_AUDIENCE=ecommerce
REDIS_URL=redis://recommendation-redis:6379
