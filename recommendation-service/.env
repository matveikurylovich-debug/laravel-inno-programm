# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app_user:@recommendation-pgvector:5432/recommendation_db?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> kafka ###
KAFKA_BROKERS=kafka:9092
KAFKA_CATALOG_TOPIC=catalog.events
KAFKA_CONSUMER_GROUP=recommendation-indexer-group
KAFKA_DSN=kafka://${KAFKA_BROKERS}/${KAFKA_CATALOG_TOPIC}?group.id=${KAFKA_CONSUMER_GROUP}
###< kafka ###

###> recommendation ###
SIMILARITY_THRESHOLD=0.57
CONVERSATION_TTL_MINUTES=30
REDIS_URL=redis://recommendation-redis:6379
JWT_JWKS_URL=http://auth-nginx/api/v1/internal/jwks
JWT_JWKS_PATH=
JWT_ISSUER=http://auth-app
JWT_AUDIENCE=ecommerce
###< recommendation ###

###> google/gemini-api ###
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TEXT_MODEL=gemini-3.5-flash
###< google/gemini-api ###
