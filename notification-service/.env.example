APP_NAME="Notification Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=notifications_db

SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=mongodb
KAFKA_CACHE_DRIVER=mongodb

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ecommerce.local"
MAIL_FROM_NAME="${APP_NAME}"

JWT_JWKS_URL=http://auth-nginx/.well-known/jwks.json
JWT_ISSUER=http://auth-app
JWT_AUDIENCE=ecommerce

KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_AUTH_EVENTS=auth.events
KAFKA_TOPIC_ORDER_EVENTS=order.events
KAFKA_AUTH_CONSUMER_GROUP=notification-service.auth-events
KAFKA_ORDER_CONSUMER_GROUP=notification-service.order-events
KAFKA_AUTH_DLQ_TOPIC=auth.events.dlq.notification-service
KAFKA_ORDER_DLQ_TOPIC=order.events.dlq.notification-service
KAFKA_CONSUMER_RETRIES=3
KAFKA_CONSUMER_RETRY_BACKOFF_MS=1000
