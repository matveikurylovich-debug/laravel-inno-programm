APP_NAME="Auth Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=auth-db
DB_PORT=5432
DB_DATABASE=auth
DB_USERNAME=auth
DB_PASSWORD=secret

SESSION_DRIVER=array
SESSION_SECURE_COOKIE=true
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=auth-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

JWT_ISSUER=http://auth-app
JWT_AUDIENCE=ecommerce
JWT_ACCESS_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_PREVIOUS_PUBLIC_KEY_PATH=
JWT_ACCESS_KID=auth-1
JWT_ACCESS_PREVIOUS_KID=
JWT_JWKS_PATH=
JWT_JWKS_URL=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
JWT_REFRESH_GRACE_SECONDS=30
JWT_ACCESS_COOKIE=__Host-access
JWT_REFRESH_COOKIE=refresh_token

KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_AUTH_EVENTS=auth.events

ANALYTICS_RABBITMQ_URL=amqp://guest:guest@analytics-rabbitmq:5672/
ANALYTICS_RABBITMQ_EXCHANGE=analytics.events

L5_SWAGGER_GENERATE_ALWAYS=false
