HTTP_PORT=8080

CLICKHOUSE_ADDR=analytics-clickhouse:9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=secret

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@analytics-rabbitmq:5672/
RABBITMQ_EXCHANGE=analytics.events

FORWARD_HTTP_PORT=8090
FORWARD_HTTPS_PORT=8448
FORWARD_RABBITMQ_UI_PORT=15672
