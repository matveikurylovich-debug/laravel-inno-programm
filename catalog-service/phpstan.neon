includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - app
        - config
        - database
        - routes
        - tests
    excludePaths:
        - config/l5-swagger.php
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        -
            message: '#^(Call to an undefined method|Access to an undefined property) Pest\\PendingCalls\\TestCall::#'
            path: tests/*
    tmpDir: /tmp/phpstan-catalog
