{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ecommerce/catalog-service",
    "type": "project",
    "description": "Product catalog and inventory service for the shop.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "ext-rdkafka": "*",
        "ext-redis": "*",
        "darkaonline/l5-swagger": "^11.2",
        "ecommerce/platform-kit": "^1.0",
        "filament/filament": "^3.2",
        "firebase/php-jwt": "^7.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mateusjunges/laravel-kafka": "^2.11"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.5 <8.9.6",
        "nunomaduro/termwind": "2.4.0",
        "pestphp/pest": "^5.2 <5.3.5",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.3.3",
        "rector/rector": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "analyse:baseline": "phpstan analyse --memory-limit=1G --generate-baseline",
        "refactor": "rector process --dry-run --no-progress-bar",
        "refactor:fix": "rector process --no-progress-bar",
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --exclude-group=pgsql"
        ],
        "check": [
            "@lint",
            "@refactor",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "platform-check": "php-only",
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../packages/platform-kit",
            "options": {
                "symlink": true
            }
        }
    ]
}
