APP_NAME="Catalog Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost:8443

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=catalog-postgres
DB_PORT=5432
DB_DATABASE=catalog_db
DB_USERNAME=catalog
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=catalog-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=catalog-images
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/catalog-images
AWS_USE_PATH_STYLE_ENDPOINT=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

FORWARD_DB_PORT=5434
FORWARD_REDIS_PORT=6381
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001
FORWARD_HTTPS_PORT=8443

JWT_ACCESS_SECRET=
JWT_ALGO=HS256

KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=catalog-service-group
KAFKA_TOPIC_ORDER_EVENTS=order.events
KAFKA_TOPIC_INVENTORY_EVENTS=inventory.events
KAFKA_TOPIC_CATALOG_EVENTS=catalog.events

VITE_APP_NAME="${APP_NAME}"
